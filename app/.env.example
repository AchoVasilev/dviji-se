# Variable names must match internal/config/config.go.
#
# The app loads "<ENVIRONMENT>.env" from the working directory at startup, so a
# local setup lives in local.env and ENVIRONMENT is set to "local".

# ===========================================
# Server
# ===========================================
PORT=8080
ENVIRONMENT=production
APP_BASE_URL=https://your-domain.com

# ===========================================
# Database
# ===========================================
DBHOST=
DBPORT=5432
DBUSER=
DBPASSWORD=
DBNAME=dviji_se
DBSSLMODE=require
DBCONNECTIONS=10

# ===========================================
# Security (required - generate with: openssl rand -hex 32)
# ===========================================
JWT_KEY=
JWT_REFRESH_KEY=
XSRF=

# Networks whose X-Forwarded-For / X-Real-IP headers may be trusted, as a
# comma separated list of CIDRs or IPs. Leave empty when the app is exposed
# directly: any client can forge those headers and bypass rate limiting.
# Set this to your load balancer's range when running behind one.
# TRUSTED_PROXIES=10.0.0.0/8

# ===========================================
# CORS (comma-separated origins)
# ===========================================
CORS_ORIGINS=https://your-domain.com

# ===========================================
# Registration (disabled by default)
# ===========================================
# Off unless set. When off, /login, /register, /forgot-password and
# /reset-password redirect to the home page and their nav entries are hidden;
# only the admin login at /admin/login remains.
ALLOW_REGISTRATION=false

# ===========================================
# Feature flags (nav entries for unbuilt sections)
# ===========================================
# These only control whether the navigation link is shown. The routes do not
# exist yet, so turning one on before building the page yields a 404.
ENABLED_WORKOUTS=false
ENABLED_NUTRITION=false

# ===========================================
# First administrator
# ===========================================
# Registration only ever grants the USER role, so a fresh database has no way
# into the admin panel. These seed the first administrator on startup and are
# ignored once one exists - they cannot reset or overwrite an existing account.
# The password must satisfy the policy: 12+ characters with an upper case
# letter, a lower case letter, a digit and a symbol.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ===========================================
# Email (optional - password reset emails are logged when unset)
# ===========================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# ===========================================
# Cloudinary (optional - for image uploads)
# ===========================================
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=dviji-se

# ===========================================
# Privacy policy
# ===========================================
# The address /privacy tells visitors to write to for access, deletion or a
# withdrawal of consent. Defaults to privacy@<host of APP_BASE_URL>, so point
# it at a mailbox somebody actually reads.
# PRIVACY_CONTACT_EMAIL=

# ===========================================
# TinyMCE (WYSIWYG editor for admin)
# ===========================================
TINYMCE_URL=https://cdn.tiny.cloud/1/your-api-key/tinymce/6/tinymce.min.js
