# Variable names must match internal/config/config.go.
#
# The app loads "<ENVIRONMENT>.env" from the working directory at startup, so a
# local setup lives in local.env and ENVIRONMENT is set to "local".

# ===========================================
# Server
# ===========================================
PORT=8080
ENVIRONMENT=production
APP_BASE_URL=https://your-domain.com

# ===========================================
# Database
# ===========================================
DBHOST=
DBPORT=5432
DBUSER=
DBPASSWORD=
DBNAME=dviji_se
DBSSLMODE=require
DBCONNECTIONS=10

# ===========================================
# Security (required - generate with: openssl rand -hex 32)
# ===========================================
JWT_KEY=
JWT_REFRESH_KEY=
XSRF=

# Networks whose X-Forwarded-For / X-Real-IP headers may be trusted, as a
# comma separated list of CIDRs or IPs. Leave empty when the app is exposed
# directly: any client can forge those headers and bypass rate limiting.
# Set this to your load balancer's range when running behind one.
# TRUSTED_PROXIES=10.0.0.0/8

# ===========================================
# CORS (comma-separated origins)
# ===========================================
CORS_ORIGINS=https://your-domain.com

# ===========================================
# Registration (disabled by default)
# ===========================================
ALLOW_REGISTRATION=false

# ===========================================
# Email (optional - password reset emails are logged when unset)
# ===========================================
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# ===========================================
# Cloudinary (optional - for image uploads)
# ===========================================
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=dviji-se

# ===========================================
# TinyMCE (WYSIWYG editor for admin)
# ===========================================
TINYMCE_URL=https://cdn.tiny.cloud/1/your-api-key/tinymce/6/tinymce.min.js
